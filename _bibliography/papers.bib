  author      = {Yao, Xiteng and Xue, Bangjie and Skjellum, Anthony and Herbordt, Martin},
  booktitle   = {Proceedings of the 16th International Symposium on Highly Efficient Accelerators and Reconfigurable Technologies (HEART)},
