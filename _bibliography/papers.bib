  author      = {Yao*, Xiteng and Chu*, Ziyuan and Tai*, Feng and Xue, Bangjie and Hu, Yigong and Herbordt, Martin},
  booktitle   = {2026 IEEE High Performance Extreme Computing Conference (HPEC)},
  year        = {2026},
