  author      = {Yao, Xiteng and Kim, Taeho and Pei, Hengzhi and Liu, Xinle and Ulrich, Kyle and Lausen, Leonard and Khetan, Ashish and Song, Xiang and Karypis, George and Herbordt, Martin},
