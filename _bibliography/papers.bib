@inproceedings{yao2026poolstatelens,
  preview     = {poolstatelens.svg},
  abbr        = {HPEC},
  bibtex_show = {true},
  selected    = {true},
  title       = {{PoolStateLens}: Evaluating the Performance of an On-Switch Memory Pool for {LLM} Training},
  author      = {Yao, Xiteng and Herbordt, Martin},
  booktitle   = {2026 IEEE High Performance Extreme Computing Conference (HPEC)},
  year        = {2026},
  pdf         = {https://ieee-hpec.org/wp-content/uploads/2026/09/327.pdf},
  abstract    = {A switch-attached memory pool can hold LLM training state (parameters, master weights, optimizer moments) so capacity grows independently of GPU count. PoolStateLens is a measurement-grounded analytical method that compares this design with FSDP over a full training iteration, using GB200/NVLink-5 measurements and ASTRA-sim checks. Pooling can reduce the GPU memory needed for training state, but matching FSDP speed requires about 7.9 TB/s of aggregate raw state bandwidth in a controlled 7B, 32-GPU case, under the model's assumptions.},
}

